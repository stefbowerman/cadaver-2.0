{% doc %}
  Facets Panel
  ------------------------------------------------------------------------------
  
  @param {object} results - The collection or search object
  @param {string} contents - The contents of the facets panel - contains the facets form(s)
{% enddoc %}

{%- liquid
  assign active_filters_count = 0

  for filter in results.filters
    case filter.type
      when 'price_range'
        if filter.min_value.value != null or filter.max_value.value != null
          assign active_filters_count = active_filters_count | plus: 1
        endif
      when 'boolean'
        if filter.active_values[0].value
          assign active_filters_count = active_filters_count | plus: 1
        endif
      else
        assign active_filters_count = active_filters_count | plus: filter.active_values.size
    endcase
  endfor
%}

<div data-component="facets-panel">
  {% comment %} @TODO - Hiding this until we finish sorting and move on to filtering {% endcomment %}
  {% comment %}
    {% if results.filters.size > 0 %}
      <div>
        <span data-filters-active-count {% if active_filters_count == 0 %}hidden{% endif %}>
          (<span data-filters-active-count-value>{{ active_filters_count }}</span>)
        </span>

        <button
          type="button"
          data-clear-filters
          {% if active_filters_count == 0 %}hidden{% endif %}
        >
          {{ 'actions.clear' | t }}
        </button>
      </div>
    {% endif %}
  {% endcomment %}

  <div>
    {{ contents }}
  </div>
</div>