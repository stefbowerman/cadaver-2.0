{% doc %}
  @param {number} value - The current quantity value - required
  @param {string} product_title - Product name for aria-labels - required
  @param {number} [min] - Minimum quantity allowed
  @param {number} [max] - Maximum quantity allowed
  @param {number} [step] - Increment/decrement step - defaults to 1
  @param {boolean} [increment_disabled] - Whether to disable the increment button
  @param {boolean} [decrement_disabled] - Whether to disable the decrement button
  @param {string} [input_name] - Name attribute for the input element - defaults to "quantity"

  @example
  {% render 'quantity-adjuster',
             value: 1,
             product_title: 'Product Name',
             min: 1,
             max: 10,
             step: 1,
             increment_disabled: false,
             decrement_disabled: false,
             input_name: 'quantity'
  %}
{% enddoc %}

<div
  class="quantity-adjuster"
  data-component="quantity-adjuster"
>
  <button
    type="button"
    aria-label="{{- 'products.product.quantity.decrease' | t: product: product_title | escape -}}"
    data-decrement
    {% if decrement_disabled == true %}
      disabled
    {% endif %}
  >
    {{- 'icon-minus.svg' | inline_asset_content -}}
  </button>

  <input
    type="number"
    name="{{ input_name | default: 'quantity' }}"
    value="{{ value }}"
    {% if min %}
      min="{{ min }}"
    {% endif %}
    {% if max %}
      max="{{ max }}"
    {% endif %}
    step="{{ step | default: 1 }}"
    aria-label="{{ 'products.product.quantity.input_label' | t: product: product_title | escape }}"
  >

  <button
    type="button"
    aria-label="{{- 'products.product.quantity.increase' | t: product: product_title | escape -}}"
    data-increment
    {% if increment_disabled == true %}
      disabled
    {% endif %}
  >
    {{- 'icon-plus.svg' | inline_asset_content -}}
  </button>                            
</div>