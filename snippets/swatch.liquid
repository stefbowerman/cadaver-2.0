{% doc %}
  Swatch
  ------------------------------------------------------------------------------

  @param {object} [swatch] - Swatch drop (product option value or filter value swatch)
  @param {object} [image] - Image to display - takes priority over the swatch's own image / color
  @param {object} [option_value] - ProductOptionValueDrop - used as alt text fallback
  @param {boolean} [is_decorative] - Hide the swatch from assistive tech (e.g. 'composable-input' parent already provides a11y name) - default false

  @example
    {% render 'swatch', swatch: value.swatch, option_value: value %}
{% enddoc %}

{% liquid
  assign is_decorative = is_decorative | default: false

  assign has_swatch = false
  assign swatch_image = nil
  assign swatch_color = nil

  if image
    assign swatch_image = image
  elsif swatch.image
    assign swatch_image = swatch.image
  elsif swatch.color
    assign swatch_color = swatch.color
  endif

  if swatch_image or swatch_color
    assign has_swatch = true
  endif

  assign alt = swatch_image.alt | default: option_value.name
%}

{% if has_swatch %}
  {% comment %}
    The span is the single accessible element for both color and image swatches (role="img" + aria-label),
    so the svg / img inside never need their own names. Hidden when the caller names it or there's no name.
  {% endcomment %}
  <span
    class="swatch"
    {% if swatch.color %}
      style="color: rgb({{ swatch.color.rgb }});"
    {% endif %}
    {% if is_decorative or alt == blank %}
      aria-hidden="true"
    {% else %}
      role="img"
      aria-label="{{ alt | escape }}"
    {% endif %}
  >
    {% comment %} A11y: Use an SVG to represent the swatch color rather than background-color as background-color doesn't survive high contrast mode {% endcomment %}
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect width="24" height="24" fill="currentColor"/>
    </svg>

    {% if swatch_image %}
      <img
        src="{{ swatch_image | image_url: width: 80 }}"
        alt=""
        width="{{ swatch_image.width }}"
        height="{{ swatch_image.height }}"
        style="object-position: {{ swatch_image.presentation.focal_point }}"
      >
    {% endif %}
  </span>
{% endif %}
