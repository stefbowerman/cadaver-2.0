{% doc %}
  Image Responsive
  ====================================

  @param {image} image - The image to display - required
  @param {image} [image_mobile] - The mobile image to display - optional
  @param {string} [loading] - The loading attribute value - optional - default: 'lazy'
  @param {boolean} [fetch_priority] - The fetchpriority attribute value - optional - defaults to false
  @param {string} [alt_text] - The alt text for the image - optional - defaults to image.alt
  @param {string} [sizes] - The sizes attribute value - optional - defaults to nil
{% enddoc %}


{% if image %}
  {%- liquid
    assign desktop = image
    assign mobile = image_mobile | default: image
    assign loading = loading | default: 'lazy'
    assign fetch_priority = fetch_priority | default: nil
    assign sizes = sizes | default: nil
    assign alt = alt_text | default: image.alt
    assign alt = alt | escape

    capture style
      if desktop.presentation.focal_point
        echo '--object-position-desktop: ' | append: desktop.presentation.focal_point | append: ';'
      endif
      if mobile.presentation.focal_point
        echo '--object-position-mobile: ' | append: mobile.presentation.focal_point | append: ';'
      endif
    endcapture

    assign style = style | strip   
  %}

  <picture>
    <source
      srcset="
        {{ mobile | image_url: width: 180 }} 180w,
        {{ mobile | image_url: width: 300 }} 300w,
        {{ mobile | image_url: width: 500 }} 500w,
        {{ mobile | image_url: width: 700 }} 700w,
        {{ mobile | image_url: width: 900 }} 900w,
        {{ mobile | image_url: width: 1100 }} 1100w
      "
      media="(max-width: 63.99rem)"
    >
      
    <source
      srcset="
        {{ desktop | image_url: width: 1200 }} 1200w,
        {{ desktop | image_url: width: 1400 }} 1400w,
        {{ desktop | image_url: width: 1600 }} 1600w,
        {{ desktop | image_url: width: 1800 }} 1800w
      "
      media="(min-width: 64rem)"
    >

    {{
      desktop
      | image_url: width: 1200
      | image_tag:
        loading: loading,
        alt: alt,
        style: style,
        class: 'image-responsive lazy-image',
        fetchpriority: fetch_priority,
        sizes: sizes
    }}          
  </picture>
{% endif %}