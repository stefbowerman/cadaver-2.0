{% doc %}
  Graphic Cover
  ====================================
  
  @param {image} [image] - The image to display
  @param {image} [image_mobile] - The mobile image to display
  @param {video} [video] - The video to display
  @param {string} [loading] - The loading attribute value
  @param {boolean} [fetch_priority] - The fetchpriority attribute value
  @param {string} [image_sizes] - The sizes attribute value
{% enddoc %}

<div class="graphic-cover">
  {% if video != nil %}
    <div class="h-full w-full" data-component="graphic-cover-video">
      {% if image != blank %}
        {% assign poster = image | image_url: width: 1600 %}
        {{ video | video_tag: muted: true, playsinline: true, autoplay: true, loop: true, image_size: '1600x', poster: poster }}
      {% else %}
        {{ video | video_tag: muted: true, playsinline: true, autoplay: true, loop: true, image_size: '1600x' }}
      {% endif %}
    </div>
  {% endif %}

  {% if image != blank %}
    {% render 'image-responsive'
              image: image,
              image_mobile: image_mobile,
              loading: loading,
              fetch_priority: fetch_priority,
              sizes: image_sizes
    %}
  {% endif %}
</div>