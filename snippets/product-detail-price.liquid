{% doc %}
  Product Detail Price

  Price displayed on the product detail page.

  @param {object} product - The product to display - required
  @param {object} [current_variant] - The current variant to display - optional

  @example
    {% render 'product-price',
              product: product,
              current_variant: product.variants.first
    %}
{% enddoc %}

{%- liquid
  assign current_variant = current_variant | default: product.selected_or_first_available_variant

  comment
    Template Vars
  endcomment
  assign has_compare = false
  assign current_variant_on_sale = false

  if product.compare_at_price_max > product.price
    assign has_compare = true
  endif

  if current_variant.compare_at_price > current_variant.price
    assign current_variant_on_sale = true
  endif

  assign label_price = 'products.product.price.price' | t
  assign label_sale_price = 'products.product.price.sale_price' | t
%}

<div
  data-component="product-price"
  role="status"
  aria-atomic="true"
  data-label-price="{{ label_price | escape }}"
  data-label-sale-price="{{ label_sale_price | escape }}"
>
  <span>
    <span class="sr-only" data-price-label>                                                                                                  
      {% if current_variant_on_sale %}
        {{ label_sale_price }}
      {% else %}
        {{ label_price }}
      {% endif %}
    </span>     
    <span data-price-value>
      {% render 'price-formatted', price: current_variant.price %}
    </span>
  </span>

  {% if has_compare %}
    <span
      data-compare
      {% if current_variant_on_sale != true %}hidden{% endif %}
    >
      <span class="sr-only">
        {{ 'products.product.regular_price' | t }}
      </span>
      
      <s data-compare-price>
        {% if current_variant_on_sale %}
          {% render 'price-formatted', price: current_variant.compare_at_price %}
        {% endif %}
      </s>
    </span>
  {% endif %}
</div>    