{% doc %}
  Drawer

  @param {string} [id] - The ID of the drawer
  @param {string} [title] - The title of the drawer
  @param {string} [title_html] - The html content of the drawer title - will take precedence over title for display
  @param {string} [content] - The content of the drawer body
  @param {string} [component] - The component of the drawer
  @param {string} [origin] - The side of the screen the drawer opens from - defaults to 'left'
{% enddoc %}

{%- liquid
  unless origin == 'left' or origin == 'right'
    assign origin = 'left'
  endunless

  assign display_title = title_html | default: title
-%}

<div
  {% if id %}
    id="{{ id }}"
  {% endif %}
  class="drawer drawer--{{ origin }}"
  data-component="{{ component | default: 'drawer' }}"
  aria-hidden="true"
  role="dialog"
  aria-label="{{ title | default: 'Drawer' | escape }}"
  inert
>
  <div
    class="h-full flex flex-col overflow-y-scroll overflow-scroll no-scrollbar"
    data-scroller
  >
    <div class="sticky top-0 bg-white container flex justify-between items-center py-5">
      <div>{{ display_title }}</div>

      <button
        data-close
        aria-label="Close Menu"  
      >Close</button>
    </div>

    <div class="container">
      {{ content }}
    </div>
  </div>
</div>