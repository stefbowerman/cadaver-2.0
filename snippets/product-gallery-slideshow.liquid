{% doc %}
  Product Gallery Slideshow
  ====================================

  @param {string} slides - The slides to display - required
  @param {number} slides_count - The total number of slides - required

  @example
    {% render 'product-gallery-slideshow', slides: slides, slides_count: slides_count %}
{% enddoc %}

<div class="product-detail-gallery__slideshow">
  <div
    class="embla"
    role="region"
    aria-roledescription="carousel"
    aria-label="Product {{ slides_count | pluralize: 'image', 'images' }}"
  >
    <div class="embla__viewport">
      <div class="embla__container">
        {{ slides }}
      </div>
    </div>
    
    <div class="text-center" data-pagination></div>

    {% if slides_count > 1 %}
      <div class="flex justify-between items-center">
        {% comment %}
          NOTE:
            WCAG Success Criterion 2.5.3 Label in Name (Level A) requires that any interactive element with a visible text label
            must include that exact visible text inside its programmatic accessible name.

            Leaving this note here in case the button contents change in the future.
          e.g. <button type="button" aria-label="Previous Image">Previous</button>
        {% endcomment %}
        <button class="btn" type="button" data-previous>Previous Image</button>
        <button class="btn" type="button" data-next>Next Image</button>
      </div>
    {% endif %}
  </div>
</div>