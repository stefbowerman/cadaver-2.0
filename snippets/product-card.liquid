{% doc %}
  @param {product} product - The product to display - required
  @param {string} [loading] - Optional loading attribute for the image - defaults to "lazy"
  @param {string} [sizes] - Optional sizes attribute for the image - defaults to sizes for results grid
  @param {number} [image_min_width] - Optional minimum width for the image - defaults to 500
  @param {number} [image_max_width] - Optional maximum width for the image - defaults to 900  
  @param {object} [primary_image] - Primary image to display - defaults to the product's featured image
  @param {object} [secondary_image] - Secondary image to display - defaults to the product's second image
  @param {boolean} [secondary_image_enabled] - Whether to display the secondary image - defaults to false

  @example
  {% render 'product-card',
             product: product,
             loading: 'eager',
             sizes: '(max-width: 767.98px) 100vw, 25vw',
             image_min_width: 500,
             image_max_width: 900,
  %}
{% enddoc %}

{% if product %}
  {%- liquid
    assign selected_variant = product.selected_or_first_available_variant
    assign loading = loading | default: 'lazy'
    assign image_min_width = image_min_width | default: 500
    assign image_max_width = image_max_width | default: 1200
    assign sizes = sizes | default: '(max-width: 47.98rem) 50vw, (max-width: 79.98rem) 33vw, 25vw'
    assign image_class = ''
    assign is_on_sale = false
    assign primary_image = primary_image | default: product.featured_image
    assign secondary_image = secondary_image | default: product.images[1]
    assign secondary_image_enabled = secondary_image_enabled | default: false

    capture image_widths
      render 'image-widths', min_width: image_min_width, max_width: image_max_width
    endcapture

    if loading == 'lazy'
      assign image_class = 'lazy-image'
    endif

    assign product_url = product.url
    if collection and collection.handle != 'all'
      assign product_url = product.url | within: collection
    endif
    
    assign compare_at_price = selected_variant.compare_at_price
    if compare_at_price > product.price
      assign is_on_sale = true
    endif
  -%}

  <a
    href="{{ product_url }}"
    class="product-card flex flex-col gap-4"
    data-component="product-card"
  >
    <div class="relative w-full aspect-product">
      {% if primary_image %}
        <div class="product-card__media-primary">
          {{ primary_image
            | image_url: width: image_max_width
            | image_tag:
              loading: loading,
              widths: image_widths,
              class: image_class,
              sizes: sizes
            | replace: '<img ', '<img alt="" '
          }}
        </div>

        {% comment %} Nest this inside 'if primary_image' to only output secondary if the primary image exists {% endcomment %}
        {% if secondary_image and secondary_image_enabled %}
          <div class="product-card__media-secondary" data-media-secondary>
            {{ secondary_image
              | image_url: width: image_max_width
              | image_tag:
                loading: 'lazy',
                widths: image_widths,
                sizes: sizes,
                aria-hidden: true
              | replace: '<img ', '<img alt="" '
              | replace: 'src=', 'data-src=' | replace: 'srcset=', 'data-srcset='
            }}
          </div>
        {% endif %}           
      {% endif %}         
    </div>

    <div class="text-center px-4">
      <div class="font-bold">{{ product.title }}</div>
      <div>
        {% if product.available %}
          {% if is_on_sale %}
            <span class="sr-only">{{ 'products.product.price.regular_price' | t }}</span>
            <s>{% render 'price-formatted', price: compare_at_price %}</s>
            <span class="sr-only">{{ 'products.product.price.sale_price' | t }}</span>
            {% render 'price-formatted', price: selected_variant.price %}
          {%  else %}
            <span class="sr-only">{{ 'products.product.price.price' | t }}</span>
            {% render 'price-formatted', price: selected_variant.price %}
          {%  endif %}
        {% else %}
          {{ 'products.product.sold_out' | t }}
        {% endif %}
      </div>
    </div>
  </a>
{% endif %}
