{% capture content %}
  {%- if section.settings.primary_menu.links.size > 0 -%}
    <nav aria-label="{{ 'accessibility.mobile_menu.primary_menu' | t }}">
      <ul>
        {%- for link in section.settings.primary_menu.links -%}
          <li>
            {% if link.links.size > 0 %}
              {{- link.title -}}
              
              <ul class="flex flex-col py-3 px-6 text-sm">
                {% for sublink in link.links %}
                  <li>
                    <a
                      href="{{ sublink.url }}"
                      {% if sublink.current %}
                        aria-current="page"
                      {% endif %}
                    >
                      {{- sublink.title -}}
                    </a>
                  </li>
                {% endfor %}
              </ul>
            {% else %}
              <a
                href="{{ link.url }}"
                {% if link.current %}
                  aria-current="page"
                {% endif %}
              >
                {{- link.title -}}
              </a>
            {% endif %}
          </li>
        {%- endfor -%}
      </ul>
    </nav>
  {%- endif -%}

  <div class="my-16">
    {% render 'search-inline', id_prefix: section.id, clear_button: true %}
  </div>

  {%- if section.settings.secondary_menu.links.size > 0 -%}
    <nav class="text-sm" aria-label="{{ 'accessibility.mobile_menu.secondary_menu' | t }}">
      <ul>
        {%- for link in section.settings.secondary_menu.links -%}
          <li>
            <a
              href="{{ link.url }}"
              {% if link.current %}
                aria-current="page"
              {% endif %}
            >
              {{- link.title -}}
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </nav>
  {%- endif -%}
{% endcapture %}

<div
  data-section-id="{{ section.id }}" data-section-type="mobile-menu"
  {% comment %}
    Adding these classes so the link touch targets are large enough to pass a11y checks
    Remove before styling
  {% endcomment %}
  class="[&_a]:block [&_a]:py-2"
>
  {% assign title = 'layout.mobile_menu.title' | t %}

  {% render 'drawer',
             id: section.id,
             title: title,
             content: content,
             component: 'mobile-menu-drawer'
  %}
</div>
  
{% schema %}
{
  "name": "Mobile Menu",
  "settings": [
    {
      "type": "link_list",
      "id": "primary_menu",
      "label": "Primary Menu"
    },
    {
      "type": "link_list",
      "id": "secondary_menu",
      "label": "Secondary Menu"
    }
  ]
}
{% endschema %}