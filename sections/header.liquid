<header
  class="header"
  data-section-id="{{ section.id }}"
  data-section-type="header"
  role="banner"
>
  <a href="{{ routes.root_url }}" title="{{ shop.name }}" class="header-logo">
    Logo Goes Here
    <span class="sr-only">{{ shop.name }} logo</span>
  </a> 

  <div class="container">
    <div class="header-main">
      <div class="header-nav">
        <nav class="header-nav__list" aria-label="Main">
          <ul>
            <li class="lg:hidden">
              <button
                class="header-nav__item"
                data-mobile-menu-toggle
                aria-controls="mobile-menu"               
              >
                Menu
              </button>
            </li>

            {% for link in linklists[section.settings.primary_menu].links %}
              <li class="hidden lg:inline-block">
                <a
                  href="{{ link.url }}"
                  class="header-nav__item"
                  {% if link.current %}
                    aria-current="page"
                  {% endif %}                  
                >
                  {{ link.title }}
                </a>
              </li>
            {% endfor %}
          </ul>
        </nav>  
      </div>
    
      <div class="header-nav header-nav--right">
        <div class="header-nav__list">
          {%- liquid
            assign cart_item_label = 'cart.label.item' | t
            assign cart_items_label = 'cart.label.items' | t
          -%}
          
          <button
            class="header-nav__item"
            data-ajax-cart-toggle
            aria-controls="ajax-cart"
          >
            <span
              class="{% if cart.item_count > 0 %}has-items{% endif %}"
              data-component="header-cart-control"
            >
              Cart <span class="header-cart-count" data-count>{{ cart.item_count }}</span><span class="sr-only" data-count-label> {{ cart.item_count | pluralize: cart_item_label, cart_items_label }}</span>
            </span>
          </button>
        
          <a
            href="{{ routes.search_url }}"
            class="header-nav__item"
          >
            {{- 'icon-search.svg' | inline_asset_content | replace: '<svg ', '<svg aria-hidden="true" focusable="false" '-}}
            <span class="sr-only">{{ 'general.search.search' | t }}</span>
          </a>
        </div>  
      </div>
    </div>
  </div>
</header>

{% comment %}
  Borrowed from Dawn
  Not sure why they put it in the header but I'm copying them...
{% endcomment %}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    {% if shop.brand.logo %}
      "logo": {{ shop.brand.logo | image_url: width: 500 | prepend: "https:" | json }},
    {% endif %}
    {%- liquid
      assign networks = 'twitter,facebook,youtube,tiktok,instagram' | split: ','
      assign same_as = ''
      for network in networks
        assign key = 'social_link_' | append: network
        if settings[key] != blank
          assign same_as = same_as | append: settings[key] | append: '|'
        endif
      endfor
    -%}
    "sameAs": {{ same_as | split: '|' | json }},
    "url": {{ request.origin | append: routes.root_url | json }}
  }
</script>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "primary_menu",
      "label": "Primary Menu" 
    }
  ]
}
{% endschema %}