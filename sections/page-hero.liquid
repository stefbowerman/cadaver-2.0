{%- liquid
  assign loading = 'lazy'
  assign fetch_priority = blank

  if section.index0 == 0 or section.index0 == 1
    assign loading = 'eager'
    assign fetch_priority = 'high'
  endif
-%}

<div data-section-id="{{ section.id }}" data-section-type="page-hero">
  {% if section.settings.url != blank %}
    <a href="{{ section.settings.url }}">
  {% endif %}
    <div
      class="
        relative h-screen min-h-[500px] flex flex-col items-center justify-end pt-12
        {% if section.settings.dark_mode %}text-white{% else %}text-black{% endif %}
      "
    >
      {% render 'graphic-cover'
                  image: section.settings.image,
                  image_mobile: section.settings.image_mobile,
                  video: section.settings.video,
                  loading: loading,
                  fetch_priority: fetch_priority                   
      %}

      <div class="relative z-2 py-12">
        {% if section.settings.title != blank %}
          <h3 class="max-w-[7em] lg:max-w-[11em] mx-auto text-center">
            {{ section.settings.title }}
          </h3>
        {% endif %}
      </div>
    </div>
  {% if section.settings.url != blank %}
    </a>
  {% endif %}
</div>

{% schema %}
  {
    "name": "Page Hero",
    "settings": [
      {
        "type": "header",
        "content": "Graphic"
      }, 
      {
        "type": "image_picker",
        "id": "image",
        "label": "Image"
      },
      {
        "type": "image_picker",
        "id": "image_mobile",
        "label": "Image - Mobile",
        "info": "Optional - If left blank, above image will be used"
      },      
      {
        "type": "video",
        "id": "video",
        "label": "Video"
      },      
      {
        "type": "header",
        "content": "Content"
      },
      {
        "type": "text",
        "id": "title",
        "label": "Title"
      },
      {
        "type": "url",
        "id": "url",
        "label": "URL",
        "info": "Optional - If set, the entire graphic will be clickable"
      },
      {
        "type": "header",
        "content": "Design"
      },
      {
        "type": "checkbox",
        "id": "dark_mode",
        "label": "Dark Mode",
        "info": "Check if the graphic is primarily dark"
      },      
    ]    
  }
{% endschema %}