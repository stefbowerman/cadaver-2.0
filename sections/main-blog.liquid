{% paginate blog.articles by 36 %}
  <section data-section-id="{{ section.id }}" data-section-type="blog">
    <h1 class="sr-only">{{ blog.title }}</h1>

    <div class="layout-content-wrapper">
      <div class="container">
        <ul class="grid gap-y-8 gap-x-8 grid-cols-1 lg:grid-cols-2">
          {% for article in blog.articles %}
            {%- liquid
              assign loading = blank
              assign fetchpriority = blank

              if forloop.index == 1
                assign fetchpriority = 'high'
              endif

              if forloop.index <= 2
                assign loading = 'eager'
              endif
            %}

            <li>
              {% render 'article-card',
                         article: article,
                         loading: loading,
                         fetchpriority: fetchpriority
              %}
            </li>
          {% endfor %}
        </ul>
      </div>

      {% if paginate.next.is_link %}
        <a
          href="{{ paginate.next.url }}"
        >
          {{ paginate.next.title }}
        </a>
      {% endif %}
    </div>
  </section>
{% endpaginate %}

{% schema %}
{
  "name": "Blog - Main",
  "settings": [

  ]
}
{% endschema %}